# Padronizar os nomes das colunas
colnames(data_monthly) <- tolower(trimws(colnames(data_monthly)))

# Remover linhas com NA na coluna 'temperature'
data_monthly <- data_monthly %>% drop_na(temperature)

# Adicionar coluna de mês e estação
data_monthly <- data_monthly %>%
  mutate(
    # Assumindo que a coluna 'month' já existe e é numérica (1-12)
    # Se 'month' for uma string ou parte de uma data, ajuste a linha abaixo conforme necessário.
    # Por exemplo, se for 'YYYY-MM', use: month = as.integer(format(as.Date(paste0(year, "-", month, "-01")), "%m"))
    month = as.integer(month), # Convertendo para inteiro para garantir
    season = case_when(
      month %in% c(1, 2, 3) ~ "JFM", # Janeiro, Fevereiro, Março (Corrigido de 1,3,3 para 1,2,3)
      month %in% c(4, 5, 6) ~ "AMJ", # Abril, Maio, Junho
      month %in% c(7, 8, 9) ~ "JAS", # Julho, Agosto, Setembro
      month %in% c(10, 11, 12) ~ "OND", # Outubro, Novembro, Dezembro
      TRUE ~ NA_character_
    )
  ) %>%
  drop_na(season) # Remover linhas onde a estação não pôde ser determinada

message("\nPrimeiros registros do dataset mensal com estação:")
print(head(data_monthly))

# Agrupar dados por ano e estação, calculando a média da temperatura
data_seasonal <- data_monthly %>%
  group_by(year, season) %>%
  summarise(
    temperature = mean(temperature, na.rm = TRUE),
    .groups = 'drop'
  )

message("\nPrimeiros registros do dataset sazonal agregado:")
print(head(data_seasonal))

