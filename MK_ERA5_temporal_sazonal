# Função para gerar o gráfico e estatísticas para uma dada estação
generate_seasonal_plot <- function(data, current_season, plot_label) {
  seasonal_data <- data %>% filter(season == current_season)
  
  # Verificar se há dados suficientes para a análise de tendência
  if (nrow(seasonal_data) < 2) {
    message(paste("Dados insuficientes para a estação", current_season, ". Pulando o gráfico."))
    return(NULL) # Retorna NULL se não houver dados suficientes
  }
  
  # Teste de Mann-Kendall e inclinação de Sen
  mk_test <- mk.test(seasonal_data$temperature)
  zmk <- mk_test$statistic
  p_value <- mk_test$p.value
  sen_slope_result <- sens.slope(seasonal_data$temperature)
  sen_curvature <- round(sen_slope_result$estimates, 3)
  
  # Calcular a inclinação da regressão linear (LM Slope)
  lm_model <- lm(temperature ~ year, data = seasonal_data)
  slope_lm <- round(coef(lm_model)["year"], 3)
  
  # Definir limites e intervalos do eixo Y conforme solicitado
  y_min_plot <- 10 # Alterado para começar em 10°C
  y_max_plot <- 26
  y_breaks_plot <- seq(y_min_plot, y_max_plot, by = 1) # Intervalos de 1°C
  
  # Título do plot alterado para apenas "A) JFM", "B) AMJ", etc.
  plot_title <- paste0(plot_label, ") ", current_season)
  
  p <- ggplot(seasonal_data, aes(x = year, y = temperature)) +
    geom_line(color = "orange", linewidth = 1) +
    geom_point(color = "orange", size = 2) +
    geom_smooth(method = "lm", aes(group = 1), color = "red", se = FALSE,
                linetype = "dashed", linewidth = 1.5) +
    labs(x = "Year", y = "Mean Annual Temperature (°C)", title = plot_title) +
    theme_minimal(base_size = 14) + # Reduzir um pouco o base_size para caber 4 gráficos
    scale_y_continuous(breaks = y_breaks_plot, limits = c(y_min_plot, y_max_plot)) +
    scale_x_continuous(
      breaks = seq(min(data_annual$year), max(data_annual$year), by = 2), # Ajustar breaks para x para melhor visualização em 4 gráficos
      labels = as.character(seq(min(data_annual$year), max(data_annual$year), by = 2))
    ) +
    theme( axis.text.y = element_text(size = 16),
          axis.text.x = element_text(angle = 270, hjust = 1, vjust = 0.5, size = 16),
          plot.title = element_text(hjust = 0.5, size = 14, face = "bold")) + # Centralizar título do plot
    # Anotações de estatísticas
    annotate("text", x = min(seasonal_data$year), y = 16, # Alinhado com 16°C
             label = paste("p-value:", sprintf("%.3f", p_value), "\n",
                           "Sen's Slope:", sen_curvature, "°C/year", "\n",
                           "LM Slope:", slope_lm, "°C/year", "\n",
                           "ZMK:", round(zmk, 2)),
             hjust = 0, vjust = 1, size = 4.5, color = "black") + # Reduzir tamanho da fonte
    # Anotações de legenda (Observado e Tendência)
    annotate("segment", x = 2004, # Alinhado com 2004
             xend = 2006, # Fim do segmento
             y = y_min_plot + 1.5, # Posição vertical da legenda "Observed values"
             yend = y_min_plot + 1.5,
             color = "orange", linewidth = 1.0) +
    annotate("text", x = 2007, # Alinhado com o segmento, com espaçamento
             y = y_min_plot + 1.5,
             label = "Observed values",
             hjust = 0, size = 4, color = "orange") +
    annotate("segment", x = 2004, # Alinhado com 2004
             xend = 2006, # Fim do segmento
             y = y_min_plot + 0.5, # Posição vertical da legenda "Trend Line" (maior espaçamento vertical)
             yend = y_min_plot + 0.5,
             color = "red", linewidth = 1.0, linetype = "dashed") +
    annotate("text", x = 2007, # Alinhado com o segmento, com espaçamento
             y = y_min_plot + 0.5,
             label = "Trend Line (Linear)",
             hjust = 0, size = 4, color = "red")
  
  return(p)
}

