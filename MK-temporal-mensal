# Definir diretórios de entrada e saída
input_file <- "G:/My Drive/PD - USP/04_Artigos/Artigo - analise espacial P e MK/BD_mensal.csv"
output_dir <- "G:/My Drive/PD - USP/04_Artigos/Artigo - analise espacial P e MK/Resultados_MK"
dir.create(output_dir, showWarnings = FALSE)


# Carregar o dataset com separador de ponto e vírgula e garantindo a leitura correta de números decimais
data <- read_delim(input_file, delim = ";", locale = locale(decimal_mark = ","))

# Exibe as primeiras linhas do dataset para depuração
head(data)

# Verificar o nome das colunas no dataset
colnames(data) <- tolower(trimws(colnames(data)))  
colnames(data)[grepl("^id", colnames(data))] <- toupper(colnames(data)[grepl("^id", colnames(data))])  

# Converter nome dos meses para inglês, caso esteja em português
meses_pt_en <- c("jan" = "Jan", "fev" = "Feb", "mar" = "Mar", "abr" = "Apr", "mai" = "May", "jun" = "Jun", "jul" = "Jul", "ago" = "Aug", "set" = "Sep", "out" = "Oct", "nov" = "Nov", "dez" = "Dec")
data$mes <- meses_pt_en[data$mes]

# Filtrar dados para o local Porto Alegre (ID1) e mês de outubro (Oct)
target_location <- "ID1"  
target_month <- "Feb"

# Filtrar pelo período de 1979 a 2023
data <- data %>% filter(as.numeric(ano) >= 1981 & as.numeric(ano) <= 2022, mes == target_month)

# Verificar se há dados suficientes
if (nrow(data) < 3) {
  stop("Erro: Não há dados suficientes para o mês de outubro entre 1981 e 2022.")
}

# Calcular a soma mensal
monthly_data <- data %>%
  group_by(ano) %>%
  summarise(rainfall = sum(as.numeric(!!sym(target_location)), na.rm = TRUE)) %>%
  mutate(ano = as.numeric(ano))

# Calcular a tendência usando o teste de Mann-Kendall
test_result <- mk.test(monthly_data$rainfall)
p_value <- test_result$p.value
zmk <- test_result$statistic

# Calcular o Sen's Slope corretamente
sen_result <- sens.slope(monthly_data$rainfall)
sen_curvature <- sen_result$estimates

