# Definir o diretório de trabalho
setwd("G:/My Drive/PD - USP/04_Artigos/SBCG 2025/02-BD-complemento/BD-Rstudio")

# Carregar o dataset
dados <- read.csv2(file.choose())

# Verificar a estrutura dos dados carregados
str(dados)
head(dados)

# Definir os meses do ano
meses <- 1:12
nomes_meses <- c("Jan", "Fev", "Mar", "Abr", "Mai", "Jun", 
                 "Jul", "Ago", "Set", "Out", "Nov", "Dez")

# Inicializar uma lista para armazenar os resultados
resultados_mensais <- list()

# Loop para calcular correlação, regressão e p-valor para cada mês
for (i in seq_along(meses)) {
  
  # Filtrar os dados para o mês atual
  dados_mes <- dados %>% filter(mes == meses[i])
  
  # Variáveis de interesse
  X <- dados_mes$Tar
  Y_EVI <- dados_mes$EVI
  Y_NDVI <- dados_mes$NDVI
  Y_LAI <- dados_mes$LAI
  
  # Calcular correlação (tratando possíveis NAs)
  correlacao_EVI <- cor(X, Y_EVI, method = "pearson", use = "complete.obs")
  correlacao_NDVI <- cor(X, Y_NDVI, method = "pearson", use = "complete.obs")
  correlacao_LAI <- cor(X, Y_LAI, method = "pearson", use = "complete.obs")
  
  # Modelos de regressão linear
  reg_EVI <- lm(Y_EVI ~ X, na.action = na.exclude)
  reg_NDVI <- lm(Y_NDVI ~ X, na.action = na.exclude)
  reg_LAI <- lm(Y_LAI ~ X, na.action = na.exclude)
  
  # Resumo dos modelos para extrair informações
  resumo_reg_EVI <- summary(reg_EVI)
  resumo_reg_NDVI <- summary(reg_NDVI)
  resumo_reg_LAI <- summary(reg_LAI)
  
  
  # Coeficiente de determinação (R²)
  R2_EVI <- resumo_reg_EVI$r.squared
  R2_NDVI <- resumo_reg_NDVI$r.squared
  R2_LAI <- resumo_reg_LAI$r.squared
  
  # P-valores dos coeficientes das variáveis X (Tar)
  p_valor_EVI <- resumo_reg_EVI$coefficients[2, 4]
  p_valor_NDVI <- resumo_reg_NDVI$coefficients[2, 4]
  p_valor_LAI <- resumo_reg_LAI$coefficients[2, 4]
  
  # Organizar os resultados em uma tabela para o mês atual
  resultados_mes <- data.frame(
    Mes = nomes_meses[i],
    Indicador = c("EVI", "NDVI","LAI"),
    Correlacao = c(correlacao_EVI, correlacao_NDVI, correlacao_LAI),
    R2 = c(R2_EVI, R2_NDVI,R2_LAI),
    P_Valor = c(p_valor_EVI, p_valor_NDVI,p_valor_LAI)
  )
  
  # Adicionar os resultados do mês atual à lista de resultados
  resultados_mensais[[i]] <- resultados_mes
}

# Combinar os resultados de todos os meses em um único dataframe
resultados_finais <- do.call(rbind, resultados_mensais)

# Exibir a tabela de resultados finais
print(resultados_finais)

# Salvar os resultados em um arquivo CSV (opcional)
write.csv(resultados_finais, "resultados_correlacao_regressao_mensal.csv", row.names = FALSE)


