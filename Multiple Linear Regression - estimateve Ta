# --- 2. LIMPEZA ROBUSTA (ROBUST CLEANING) ---
limpar_dados <- function(df) {
  # Standardize names
  colnames(df)[grep("mes", colnames(df), ignore.case = TRUE)]  <- "Mes"
  colnames(df)[grep("lat", colnames(df), ignore.case = TRUE)]  <- "Latitude"
  colnames(df)[grep("long", colnames(df), ignore.case = TRUE)] <- "Longitude"
  colnames(df)[grep("alti", colnames(df), ignore.case = TRUE)] <- "Altitude"
  
  # Create ID if missing
  if(!any(grepl("id", colnames(df), ignore.case = TRUE))) df$ID <- paste0("P", 1:nrow(df))
  else colnames(df)[grep("id", colnames(df), ignore.case = TRUE)] <- "ID"
  
  # Convert numbers
  cols_num <- c("NDVI", "EVI", "Latitude", "Longitude", "Altitude", "Tar", "Ts_terra", "Ts_aqua", "MDLST_terra", "MDLST_aqua")
  for(col in cols_num) {
    if(col %in% colnames(df)) {
      df[[col]] <- as.numeric(gsub(",", ".", as.character(df[[col]])))
    }
  }
  
  # Seasonality (Month as Ordered Factor)
  if("Mes" %in% colnames(df)) df$Mes <- factor(as.numeric(df$Mes), levels=1:12)
  
  return(df)
}

dados <- limpar_dados(dados_brutos)


