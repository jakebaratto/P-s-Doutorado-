# Passo 2: Carregar o banco de dados

# Importante: selecionar o diretório de trabalho (working directory)
# Isso pode ser feito manualmente: Session > Set Working Directory > Choose Directory

setwd("G:/My Drive/PD - USP/03_Dados_resultados_usar_PD_FAPESP/Regressão multipla")


dados <- read.csv2(file.choose())
glimpse(dados)

## Construção do modelo:
mod <- lm(tar ~ NDVI + lat+ long + alti + ts, dados)


## Análise gráfica:
par(mfrow=c(2,2))

plot(mod)

par(mfrow=c(1,1))


## Normalidade dos resíduos:
shapiro.test(mod$residuals)


## Outliers nos resíduos:
summary(rstandard(mod))


## Independência dos resíduos (Durbin-Watson):
durbinWatsonTest(mod)


## Homocedasticidade (Breusch-Pagan):
bptest(mod)


## Ausência de Multicolinearidade

pairs.panels(dados)
### Multicolinearidade: r > 0.9 (ou 0.8)

vif(mod)
### Multicolinearidade: VIF > 10


###### Criação de um segundo modelo
mod2 <- lm(tar ~ NDVI + lat + long + ts, dados)

mod3 <- lm(tar ~ NDVI + alti + ts, dados)
mod4 <- lm(tar ~ NDVI + ts, dados)

# Passo 4: Análise do modelo
summary(mod)
summary(mod2)
summary(mod3)
summary(mod4)

## Obtenção dos coeficientes padronizados
lm.beta(mod)
lm.beta(mod4)


## Obtenção do IC 95% para os coeficientes
confint(mod)
confint(mod4)


# Comparação de modelos

## AIC e BIC - Comparação entre quaisquer modelos
AIC(mod, mod4)
BIC(mod, mod4)


## Para comparação entre modelos aninhados

anova(mod, mod4)

### O melhor será o com menor valor de RSS (residual sum of squares)



# Passo 5: Gráfico de dispersão
