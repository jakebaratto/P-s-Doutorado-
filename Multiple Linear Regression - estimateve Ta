# --- 4. FUNÇÃO MESTRE DE ANÁLISE (MASTER ANALYSIS FUNCTION) ---
processar_satelite <- function(df, nome_satelite, col_lst) {
  
  cat(paste0("\n>>> PROCESSING: ", nome_satelite, " <<<\n"))
  
  # A. DATA SELECTION
  cols_uso <- c("ID", "Tar", "EVI", "Mes", col_lst, "Latitude", "Longitude", "Altitude")
  cols_uso <- cols_uso[cols_uso %in% colnames(df)]
  dados_mod <- na.omit(df[, cols_uso])
  
  if(nrow(dados_mod) == 0) return(NULL)
  
  # B. MODELING (StepAIC)
  vars_iniciais <- c("EVI", "Mes", col_lst)
  if(length(unique(dados_mod$Latitude)) > 1)  vars_iniciais <- c(vars_iniciais, "Latitude")
  if(length(unique(dados_mod$Longitude)) > 1) vars_iniciais <- c(vars_iniciais, "Longitude")
  if(length(unique(dados_mod$Altitude)) > 1)  vars_iniciais <- c(vars_iniciais, "Altitude")
  
  form_full <- as.formula(paste("Tar ~", paste(vars_iniciais, collapse=" + ")))
  mod_full <- lm(form_full, data = dados_mod)
  
  cat("   -> Running StepAIC...\n")
  capture.output(mod_best <- stepAIC(mod_full, direction = "backward", trace = FALSE), file = "NUL")
  
  mod_final <- if(AIC(mod_best) < AIC(mod_full)) mod_best else mod_full
  
  # C. CONSOLIDATED TABLE PREPARATION
  metrics_full <- c(AIC(mod_full), BIC(mod_full), summary(mod_full)$adj.r.squared, sqrt(mean(mod_full$residuals^2)))
  metrics_best <- c(AIC(mod_best), BIC(mod_best), summary(mod_best)$adj.r.squared, sqrt(mean(mod_best$residuals^2)))
  
  vars_full_str <- paste(vars_iniciais, collapse = ", ")
  vars_best_str <- paste(names(coef(mod_best))[-1], collapse = ", ") 
  vars_best_str <- gsub("Mes[0-9]+", "Mes", vars_best_str) 
  vars_best_str <- paste(unique(unlist(strsplit(vars_best_str, ", "))), collapse = ", ")
  
  df_tabela <- data.frame(
    Satellite = c(nome_satelite, nome_satelite),
    Model = c("Full Model", "StepAIC"),
    Variables = c(vars_full_str, vars_best_str),
    AIC = c(metrics_full[1], metrics_best[1]),
    BIC = c(metrics_full[2], metrics_best[2]),
    R2_Adj = c(metrics_full[3], metrics_best[3]),
    RMSE = c(metrics_full[4], metrics_best[4])
  )
  
  stargazer(mod_full, mod_best, type="text", title=nome_satelite, out=paste0(nome_pasta, "/05_Resumo_", nome_satelite, ".txt"))
  
  # D. IMPORTANCE (PLOT)
  summ <- summary(mod_final)
  imp_df <- data.frame(Var=rownames(summ$coefficients), Importance=abs(summ$coefficients[, "t value"]))
  imp_df <- imp_df[order(-imp_df$Importance), ]
  imp_plot_df <- imp_df[imp_df$Var != "(Intercept)", ]
  
  imp_plot_df$Var <- imp_plot_df$Var %>% 
    str_replace_all("Mes", "Month ") %>%
    str_replace_all("Ts_terra", "LST (Terra)") %>%
    str_replace_all("MDLST_terra", "MDLST (Terra)") %>%
    str_replace_all("Altitude", "Elevation")
  
  # AQUI: Aumentamos a fonte do gráfico de Importância também (base_size = 16)
  p_imp <- ggplot(imp_plot_df, aes(x=reorder(Var, Importance), y=Importance)) +
    geom_bar(stat="identity", fill="#2c3e50", width=0.7) + coord_flip() +
    labs(title=nome_satelite, x="", y="Importance (t-value)") + 
    theme_bw(base_size = 16)
  
  ggsave(paste0(nome_pasta, "/02_Importancia_", nome_satelite, ".png"), p_imp, width=7, height=6)
  
  # E. RESIDUAL DIAGNOSTICS
  png(paste0(nome_pasta, "/03_Residuos_", nome_satelite, ".png"), width=2000, height=2000, res=300)
  par(mfrow=c(2,2)); plot(mod_final); dev.off(); par(mfrow=c(1,1))
  
  # F. PREDICTION + FINAL PLOT (ARTICLE STYLE)
  dados_mod$Predito <- predict(mod_final, newdata = dados_mod)
  
  obs <- dados_mod$Tar
  pred <- dados_mod$Predito
  lin_mod <- lm(Predito ~ Tar, data = dados_mod)
  intercept <- coef(lin_mod)[1]; slope <- coef(lin_mod)[2]
  sign_int <- if(intercept >= 0) "+" else "-"
  
  r2 <- summary(mod_final)$adj.r.squared
  rmse <- sqrt(mean((pred - obs)^2))
  mae <- mean(abs(pred - obs))
  bias <- mean(pred - obs)
  
  stats_text <- paste0(
    "y = ", sprintf("%.2f", slope), "x ", sign_int, " ", sprintf("%.2f", abs(intercept)), "\n",
    "R² = ", sprintf("%.2f", r2), "\n",
    "RMSE = ", sprintf("%.2f", rmse), " °C\n",
    "MAE = ", sprintf("%.2f", mae), " °C\n",
    "Bias = ", sprintf("%.2f", bias), " °C"
  )
  
  user_palette <- c("1"="#800000","2"="#FF0000","3"="#FA8072","4"="#8B4513","5"="#bc7f17","6"="#DEB887",
                    "7"="#f7e501","8"="#FFFF00","9"="#fede7d","10"="#D2691E","11"="#FF8C00","12"="#FF4500")
  
  limits_range <- range(c(obs, pred))
  
  p_pred <- ggplot(dados_mod, aes(x = Tar, y = Predito)) +
    geom_point(aes(color = Mes), alpha = 0.8, size = 2.5) +
    geom_smooth(method = "lm", color = "blue", size = 0.8, se = FALSE) +
    geom_abline(intercept = 0, slope = 1, linetype = "dashed", color = "black", size = 0.8) +
    
    # AQUI: Aumentamos o tamanho do texto da equação (size = 6)
    annotate("text", x = limits_range[1], y = limits_range[2], label = stats_text, 
             hjust = 0, vjust = 1, size = 6, fontface = "bold") +
    
    scale_color_manual(values = user_palette, name = "Month", drop=TRUE) +
    labs(title = nome_satelite, x = "Observed Temperature (°C)", y = "Predicted Temperature (°C)") +
    
    # AQUI: base_size = 16 garante que NÚMEROS DO EIXO X/Y fiquem grandes
    theme_bw(base_size = 16) + 
    theme(legend.position = "right")
  
  return(list(data=dados_mod, plot_imp=p_imp, plot_pred=p_pred, stats_table=df_tabela))
}


# --- 5. EXECUÇÃO (EXECUTION) ---
col_terra <- if("MDLST_terra" %in% colnames(dados)) "MDLST_terra" else "Ts_terra"
