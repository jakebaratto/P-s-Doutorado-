Map.addLayer(mudancasP.clip(roi), { palette: ['red'] }, 'Mudanças perda comparado com a Desvio_P');

///calcular a área de mudanças (ganho)

var diferencaP = mudancasP.multiply(ee.Image.pixelArea()).divide(1e6) 
//para converter para km²

var area_mudanca_maskP = diferencaP.reduceRegion({
