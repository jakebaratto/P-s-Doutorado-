 // bestEffort: true, 
  maxPixels:1e13})

var area_mudancaAnoP= ee.Number(area_mudanca_maskP.get('NDVI')).format('%.2f')

print('8 - Área total de perda de vegetação comparado com o DP',area_mudancaAnoP)

// ========================================================================
//valores positivo (ganho) para o ano 

var mudancasG = apAno.gte(limiar_mx_dp).selfMask();

Map.addLayer(mudancasG.clip(roi), { palette: ['green'] }, 'Mudanças ganho comparado com a Desvio_P ');

///calcular a área de mudanças (perda)

var diferencaG = mudancasG.multiply(ee.Image.pixelArea()).divide(1e6) 
//para converter para km²

var area_mudanca_maskG = diferencaG.reduceRegion({
  reducer: ee.Reducer.sum(), //quero somar a área total
  geometry: roi,
  scale:250, 
  crs:'EPSG: 31982',//SIRGAS 2000 22S  
 // bestEffort: true, 
  maxPixels:1e13})

var area_mudancaAnoG= ee.Number(area_mudanca_maskG.get('NDVI')).format('%.2f')

print('9 - Área total de ganho de vegetação comparado ao DP',area_mudancaAnoG)

