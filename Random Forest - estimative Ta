# --- 2. LIMPEZA ---
clean_data <- function(df) {
  colnames(df)[grep("mes", colnames(df), ignore.case = TRUE)]  <- "Mes"
  colnames(df)[grep("lat", colnames(df), ignore.case = TRUE)]  <- "Latitude"
  colnames(df)[grep("long", colnames(df), ignore.case = TRUE)] <- "Longitude"
  colnames(df)[grep("alti", colnames(df), ignore.case = TRUE)] <- "Altitude"
  
  # Padronização do ID
  if(any(grepl("^id$", colnames(df), ignore.case = TRUE))) {
    colnames(df)[grep("^id$", colnames(df), ignore.case = TRUE)] <- "ID"
  } else {
    cat("Aviso: Coluna 'ID' não encontrada. Criando ID baseado em Lat/Long.\n")
    df <- df %>% 
      group_by(Latitude, Longitude) %>%
      mutate(ID = paste0("Ponto_", cur_group_id())) %>%
      ungroup()
  }
  
  num_cols <- c("NDVI", "EVI", "Latitude", "Longitude", "Altitude", "Tar", "MDLST_terra", "MDLST_aqua")
  for(col in num_cols) {
    if(col %in% colnames(df)) {
      df[[col]] <- as.numeric(gsub(",", ".", as.character(df[[col]])))
    }
  }
  
  if("Mes" %in% colnames(df)) {
    df$Mes <- factor(as.numeric(df$Mes), levels = 1:12)
  }
  
  return(df)
}

data <- clean_data(raw_data)


# --- 3. FUNÇÃO MESTRE RANDOM FOREST ---
run_rf_full <- function(df, sat_name, lst_col) {
  
  cat(paste0("\n>>> PROCESSING RF: ", sat_name, " <<<\n"))
  
  # A. SELEÇÃO
  use_cols <- c("ID", "Tar", "EVI", "Mes", lst_col, "Latitude", "Longitude", "Altitude")
  use_cols <- use_cols[use_cols %in% colnames(df)]
  
  df_mod <- na.omit(df[, use_cols])
  df_mod$Mes <- droplevels(df_mod$Mes)
  
  if(nrow(df_mod) == 0) return(NULL)
  
  # B. MODELAGEM
  set.seed(123)
  inTrain <- createDataPartition(y = df_mod$Tar, p = 0.7, list = FALSE)
  train_set_full <- df_mod[inTrain, ] 
  
  # Remove ID para treino
  cols_to_train <- setdiff(colnames(train_set_full), "ID")
  train_set_model <- train_set_full[, cols_to_train]
  
  # Tuning Simples
  rf_final <- randomForest(Tar ~ ., data = train_set_model, ntree = 500, importance = TRUE)
  
  # C. IMPORTÂNCIA
  imp <- importance(rf_final)
  imp_df <- data.frame(Variable = row.names(imp), IncMSE = imp[,"%IncMSE"])
  
  imp_df$Variable <- dplyr::recode(imp_df$Variable,
                                   "Mes" = "Month",
                                   "MDLST_terra" = "MDLST (Terra)",
                                   "MDLST_aqua" = "MDLST (Aqua)",
                                   "alti" = "Elevation",
                                   "Altitude" = "Elevation",
                                   "lat" = "Latitude",
                                   "Latitude" = "Latitude",
                                   "long" = "Longitude",
                                   "Longitude" = "Longitude")
  
  p_imp <- ggplot(imp_df, aes(x = IncMSE, y = reorder(Variable, IncMSE))) +
    geom_segment(aes(yend = Variable), xend = 0, color = "grey50") + 
    geom_point(size = 4, color = "black") + 
    labs(title = sat_name, x = "% Increase in MSE", y = "") +
    theme_bw(base_size = 16)
  
  # D. PREDIÇÃO E CÁLCULO DE MÉTRICAS
  df_mod$Predicted_RF <- predict(rf_final, newdata = df_mod)
  
  obs <- df_mod$Tar
  pred <- df_mod$Predicted_RF
  
  lin_mod <- lm(pred ~ obs)
  intercept <- coef(lin_mod)[1]; slope <- coef(lin_mod)[2]
  sign_int <- if(intercept >= 0) "+" else "-"
  
  r2 <- cor(obs, pred)^2
  rmse <- sqrt(mean((pred - obs)^2))
  mae <- mean(abs(pred - obs))
  bias <- mean(pred - obs)
  
  stats_text <- paste0(
    "y = ", sprintf("%.2f", slope), "x ", sign_int, " ", sprintf("%.2f", abs(intercept)), "\n",
    "R² = ", sprintf("%.2f", r2), "\n",
    "RMSE = ", sprintf("%.2f", rmse), " °C\n",
    "MAE = ", sprintf("%.2f", mae), " °C\n",
    "Bias = ", sprintf("%.2f", bias), " °C"
  )
  
  user_palette <- c(
    "1"  = "#800000", "2"  = "#FF0000", "3"  = "#FA8072",
    "4"  = "#8B4513", "5"  = "#bc7f17", "6"  = "#DEB887",
    "7"  = "#f7e501", "8"  = "#FFFF00", "9"  = "#fede7d",
    "10" = "#D2691E", "11" = "#FF8C00", "12" = "#FF4500"
  )
  
  limits_range <- range(c(obs, pred))
  
  # E. GRÁFICO IDÊNTICO À REGRESSÃO
  p_pred <- ggplot(df_mod, aes(x = Tar, y = Predicted_RF)) +
    geom_point(aes(color = Mes), size = 2.5, alpha = 0.8) +
    geom_smooth(method = "lm", color = "blue", size = 0.8, se = FALSE) +
    geom_abline(intercept = 0, slope = 1, linetype = "dashed", color = "black", size = 0.8) +
    annotate("text", x = limits_range[1], y = limits_range[2], label = stats_text, 
             hjust = 0, vjust = 1, size = 6, fontface = "bold") +
    scale_color_manual(values = user_palette, name = "Month", drop = TRUE) +
    labs(title = sat_name, 
         x = "Observed Temperature (°C)", 
         y = "Predicted Temperature (°C)") +
    theme_bw(base_size = 16) +
    theme(legend.position = "right")
  
  write.csv(df_mod, paste0(folder_name, "/Dados_Preditos_RF_", sat_name, ".csv"), row.names = FALSE)
  
  return(list(plot_imp = p_imp, plot_pred = p_pred))
}

# --- 4. EXECUÇÃO ---
res_terra <- run_rf_full(data, "MODIS Terra", "MDLST_terra")
res_aqua  <- NULL
if("MDLST_aqua" %in% colnames(data)) {
  res_aqua <- run_rf_full(data, "MODIS Aqua", "MDLST_aqua")
