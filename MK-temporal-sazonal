# Definir diretórios de entrada e saída
input_file <- "G:/My Drive/PD - USP/04_Artigos/Artigo - analise espacial P e MK/BD_mensal.csv"
output_dir <- "G:/My Drive/PD - USP/04_Artigos/Artigo - analise espacial P e MK/Resultados_MK"
dir.create(output_dir, showWarnings = FALSE)

# Carregar o dataset com separador de ponto e vírgula
data <- read_delim(input_file, delim = ";", locale = locale(decimal_mark = ","))

# Verificar e ajustar nomes de colunas
colnames(data) <- tolower(trimws(colnames(data)))
colnames(data)[grepl("^id", colnames(data))] <- toupper(colnames(data)[grepl("^id", colnames(data))])

# Converter meses de português para inglês
meses_pt_en <- c("jan" = "Jan", "fev" = "Feb", "mar" = "Mar", "abr" = "Apr", "mai" = "May", 
                 "jun" = "Jun", "jul" = "Jul", "ago" = "Aug", "set" = "Sep", "out" = "Oct", 
                 "nov" = "Nov", "dez" = "Dec")
data$mes <- meses_pt_en[data$mes]

# Definir local e trimestre (JFM)
target_location <- "ID1"
target_months <- c("Jan", "Feb", "Mar")
#target_months <- c("Apr", "May", "Jun")
#target_months <- c("Jul", "Aug", "Sep")
#target_months <- c("Oct", "Nov", "Dec")

# Filtrar para o período de 1981 a 2022 e meses JFM
data <- data %>% 
  filter(as.numeric(ano) >= 1981 & as.numeric(ano) <= 2022, mes %in% target_months)

# Verificar se há dados suficientes
if (nrow(data) < 3) {
  stop("Erro: Não há dados suficientes para o trimestre JFM entre 1981 e 2022.")
}

# Calcular a precipitação trimestral (JFM) por ano
quarterly_data <- data %>%
  group_by(ano) %>%
  summarise(rainfall = sum(as.numeric(!!sym(target_location)), na.rm = TRUE)) %>%
  mutate(ano = as.numeric(ano))

# Calcular a tendência usando o teste de Mann-Kendall
test_result <- mk.test(quarterly_data$rainfall)
p_value <- test_result$p.value
zmk <- test_result$statistic

# Calcular o Sen's Slope
sen_result <- sens.slope(quarterly_data$rainfall)
sen_curvature <- sen_result$estimates

