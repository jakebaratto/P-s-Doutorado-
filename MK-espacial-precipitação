// Carregar a ROI (Região de Interesse)
var roi = ee.FeatureCollection('projects/ee-jakelinebarattogeo/assets/SCCI_disso');

// Centralizar o mapa na ROI
Map.centerObject(roi, 8);

// Definir as datas de início e fim do período de análise
var startdate = ee.Date.fromYMD(1981, 1, 1);
var enddate = ee.Date.fromYMD(2023, 12, 31);

// Criar listas de meses e anos para a análise temporal
// para alterar os períodos sazonais e mensais é só alterar os meses
var months = ee.List.sequence(1, 12);
var years = ee.List.sequence(1981, 2022);

// Filtrar a coleção de imagens CHIRPS para o período e a área de interesse
var coll = ee.ImageCollection("UCSB-CHG/CHIRPS/DAILY")
    .select('precipitation')
    .filterDate(startdate, enddate)
    .filterBounds(roi);

// Verificar se a coleção não está vazia
print('1- Total de imagens em `coll`:', coll.size());

// Converter os dados diários para acumulados mensais
var precipitacao_mensal_acum = ee.ImageCollection.fromImages(
    years.map(function (y) {
        return months.map(function (m) {
            var precipitation_month = coll.filter(ee.Filter.calendarRange(y, y, 'year'))
                .filter(ee.Filter.calendarRange(m, m, 'month'))
                .sum()
                .clip(roi);
            return precipitation_month.set('year', y)
                .set('month', m)
                .set('system:time_start', ee.Date.fromYMD(y, m, 1).millis());
        });
    }).flatten()
);

var chartP = ui.Chart.image.seriesByRegion({
    imageCollection: precipitacao_mensal_acum,//Coleção mensal 
    regions: roi, 
    reducer: ee.Reducer.mean(), 
    band: 'precipitation', 
    scale: 2500, 
    xProperty: 'system:time_start', 
    seriesProperty: 'NOME'})

print(chartP, ' Precipitação mensal')

// Verificar se a coleção `precipitacao_mensal_acum` não está vazia
print('2- Total de imagens em `precipitacao_mensal_acum`:', precipitacao_mensal_acum.size());

// // Calcular a precipitação anual 
var annualPrecipitation = ee.ImageCollection.fromImages(
    years.map(function (year) {
        var yearData = precipitacao_mensal_acum.filter(ee.Filter.calendarRange(year, year, 'year')).sum().clip(roi);
        return yearData.set('year', year)
            .set('system:time_start', ee.Date.fromYMD(year, 1, 1).millis());
    })
);


