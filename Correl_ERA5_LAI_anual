////Dados Lai

var laiCollection = ee.ImageCollection('MODIS/061/MOD15A2H')
  .filterDate(startdate, enddate)
  .select(['Lai_500m', 'FparLai_QC']);  // Usar banda de qualidade correta

// Função para aplicar máscara de qualidade (bits 0–1 == 00), recortar e escalar
function maskClipAndScale(image) {
  var qc = image.select('FparLai_QC');
  var goodQuality = qc.bitwiseAnd(3).eq(0);  // bits 0 e 1 iguais a 00
  var laiScaled = image.select('Lai_500m')
    .updateMask(goodQuality)
    .multiply(0.1)  // Fator de escala
    .clip(roi)
    .copyProperties(image, ['system:time_start']);
  return laiScaled;
}

// Aplicar a função à coleção de LAI
var laiFiltered = laiCollection.map(maskClipAndScale);

// Carregar coleção MODIS NDVI (MYD13Q1 - 250m)
var ndviCollection = ee.ImageCollection('MODIS/006/MYD13Q1')
  .filterDate(startdate, enddate)
  .select('NDVI');

// Obter a projeção da imagem NDVI
var ndviProjection = ndviCollection.first().select('NDVI').projection();
var scale = 250;

// Função para reamostrar LAI para a escala do NDVI
function resampleToNDVI(img) {
  return img
    .resample('bicubic')
    .reproject({
      crs: ndviProjection.crs(),
      scale: scale
    })
    .rename('Lai_250m')
    .copyProperties(img, ['system:time_start']);
}

// Aplicar reamostragem
var laiResampled = laiFiltered.map(resampleToNDVI);

// Verificar resultado
