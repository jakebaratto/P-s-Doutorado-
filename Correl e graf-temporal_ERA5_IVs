######## Correlation and Regression Calculation ########

# Variables of interest
X <- dados_sync$Tar
Y_LAI <- dados_sync$LAI


# Calculate linear correlation for LAI
correlacao_LAI <- cor(X, Y_LAI, method = "pearson")


# Linear regression models for LAI
reg_LAI <- lm(Y_LAI ~ X)


# Summarize models to extract information
resumo_reg_LAI <- summary(reg_LAI)


# Extract coefficient of determination (R²)
R2_LAI <- resumo_reg_LAI$r.squared


# Extract p-values for coefficients of X variables (Tar)
p_valor_LAI <- resumo_reg_LAI$coefficients[2, 4]

# Organize results into a table
resultados <- data.frame(
  Indicator = c("LAI"),
  Correlation = c(correlacao_LAI),
  R2 = c(R2_LAI),
  P_Value = c(p_valor_LAI) # Corrected to p_valor_LAI
)

# Display the results table in the console
print(resultados)

######## Scatter Plot with Statistical Information ########

########## Calculation of Statistical Parameters ##########
modelo_LAI <- lm(LAI ~ Tar, data = dados_sync)
correlacao_LAI <- cor(dados_sync$Tar, dados_sync$LAI)
R2_LAI <- summary(modelo_LAI)$r.squared
p_valor_LAI <- summary(modelo_LAI)$coefficients[2, 4]

########## Scatter Plot with Statistical Information ##########

G2 = ggplot(dados_sync, aes(x = Tar)) +
  # Scatter plot for LAI
  geom_point(aes(y = LAI, color = "LAI"), alpha = 0.7, size = 3) +
  
  # Linear trend line for LAI
  geom_smooth(aes(y = LAI, color = "LAI"), method = "lm", linetype = "dashed", se = FALSE) +
  
  # Annotations of r, R² and p-value on the plot
  annotate("text",
           x = min(dados_sync$Tar, na.rm = TRUE),
           y = 0.2, # Now fixed, because the axis starts at 0
           hjust = 0,
           label = paste("LAI: r =", format(round(correlacao_LAI, 2), decimal.mark = "."),
                         "\nR² =", format(round(R2_LAI, 2), decimal.mark = "."),
                         "\nP-Value =", format(round(p_valor_LAI, 3), decimal.mark = ".")),
           color = "black", size = 4) +
  
  # Plot configurations
  labs(
    title = "(B)",
    x = "Air Temperature (Tar)",
    y = "Leaf Area Index (LAI)",
    color = ""
  ) +
  
  # Apply shades of green
  scale_color_manual(values = c("LAI" = "#527d3e")) +
  
  # Replace commas with points on axes and FORCE Y-axis to start at zero
