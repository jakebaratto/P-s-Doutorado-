///Script para baixar dados temporais anuais de NDVI e EVI para as classes manguezal do Mapbiomas
///Script criado com base no curso Google Earth Engine: do Zero ao avançado da Ferramenta GEE 
/// desenvolvido por AmbiGEO (2023).
// Scritp utilizado para desenvolvimento do Pós-Doutorado no Departamento de Geografia da USP
/// Projeto desenvolvido pela Dr. Jakeline Baratto e financiado pela FAPESP (processo: 2022/02383-3)



// --- 1. CONFIGURAÇÕES INICIAIS ---

// Coleção MapBiomas - Carregar como ee.Image, pois é uma imagem multibanda
var mapbiomasIntegration = ee.Image('projects/mapbiomas-public/assets/brazil/lulc/collection9/mapbiomas_collection90_integration_v1');
print('Dado mapbiomas (Image de integração)', mapbiomasIntegration);

// Região de interesse (ROI) principal
var roi = ee.FeatureCollection('projects/ee-jakelinebarattogeo/assets/SCCI_disso');
Map.addLayer(roi, {color: 'blue'}, 'ROI Principal');
Map.centerObject(roi, 10);

// CLASSES DE INTERESSE NO MAPBIOMAS COLLECTION 9 (CORRIGIDO VIA LEGENDA)
var MANGUE_CLASS_ID = 5; // ID da classe "Mangue"
var APICUM_CLASS_ID = 32; // ID da classe "Apicum"


// Período de Anos a Processar
var startYear = 2003;
var endYear = 2022;

// Lista de anos para iterar
var years = ee.List.sequence(startYear, endYear);

// --- 2. PREPARAR A COLEÇÃO MAPBIOMAS POR ANO (A PARTIR DA IMAGEM DE INTEGRAÇÃO) ---
var mapbiomasAnnualCollection = ee.ImageCollection(
  years.map(function(year) {
    var yearStr = ee.Number(year).format('%d');
    var bandName = ee.String('classification_').cat(yearStr);
    return mapbiomasIntegration.select(bandName).set('year', year);
  })
);
print('MapBiomas Annual Collection (derivada da integração)', mapbiomasAnnualCollection);


// --- 3. FUNÇÃO PARA CALCULAR NDVI E EVI MÉDIO POR ANO NA ÁREA COMBINADA (Manguezal + Apicum do MapBiomas) ---

var calculateAnnualMeans = function(year) {
  year = ee.Number(year);
  var yearStr = year.format('%d');

  // --- A) Obter Imagem de Classificação do MapBiomas para o Ano ---
  var classificationImage = mapbiomasAnnualCollection
                              .filter(ee.Filter.eq('year', year))
                              .first();

  // --- B) Criar Máscara para Mangue (ID 5) ---
  var mangueMask = classificationImage.eq(MANGUE_CLASS_ID)
                                         .selfMask()
                                         .clip(roi); // Clipado à ROI principal

  // --- C) Criar Máscara para Apicum (ID 32) ---
  var apicumMapbiomasMask = classificationImage.eq(APICUM_CLASS_ID)
                                                 .selfMask()
                                                 .clip(roi); // Clipado à ROI principal


  // --- D) Combinar as Máscaras (Mangue OU Apicum) ---
  var combinedMask = mangueMask.unmask(0).or(apicumMapbiomasMask.unmask(0)).selfMask();
  // Map.addLayer(combinedMask, {palette: ['orange']}, 'Máscara Combinada ' + yearStr, false); // Comentado para não poluir o mapa em loop


  // --- E) Processar MODIS (NDVI e EVI) com a Máscara de Qualidade e a Máscara Combinada ---
  var modis = ee.ImageCollection('MODIS/061/MOD13Q1')
                  .filterDate(ee.Date.fromYMD(year, 1, 1), ee.Date.fromYMD(year, 12, 31))
                  .filterBounds(roi); // Filtra pela ROI principal para otimização

  // Função para aplicar a máscara de qualidade e aplicar o fator de escala
  var maskAndScaleModis = function(image) {
    var qa = image.select('SummaryQA');
    // Cria uma máscara para pixels de alta qualidade (0: "Good Data, use with confidence")
    var qualityMask = qa.eq(0); 
    return image
      .updateMask(qualityMask)
      .select(['NDVI', 'EVI'])
      .multiply(0.0001)       
      .copyProperties(image, ['system:time_start']);
  };

  var modisMetrics = modis.map(maskAndScaleModis);
  
  // Calcular a média anual de NDVI e EVI para o ano
  var meanModisImage = modisMetrics.mean().clip(roi); // Clip na ROI principal

  // Aplicar a máscara combinada ANTES de calcular a média regional
  var maskedModisImage = meanModisImage.updateMask(combinedMask);
  // Map.addLayer(maskedModisImage.select('NDVI'), {min:0, max:1, palette: ['red', 'green']}, 'NDVI Mascarado ' + yearStr, false);


  // Calcular o valor médio de NDVI e EVI para a área combinada
  var reducedModis = maskedModisImage.reduceRegion({
    reducer: ee.Reducer.mean(),
    geometry: roi.geometry(), // Reduz sobre a ROI principal
    scale: 250, // Resolução do MODIS
    maxPixels: 1e10
  });

  var meanNDVI = reducedModis.get('NDVI');
  var meanEVI = reducedModis.get('EVI');

  return ee.Feature(null, {
    'year': year,
    'mean_NDVI': meanNDVI,
    'mean_EVI': meanEVI
  });
};

// --- 4. EXECUTAR O PROCESSAMENTO PARA TODOS OS ANOS ---

var annualMeanResults = years.map(calculateAnnualMeans);

var finalMeanCollection = ee.FeatureCollection(annualMeanResults);
print('Valores Médios Anuais de NDVI e EVI na Área Combinada (Mangue + Apicum do MapBiomas):', finalMeanCollection);

// --- 5. EXPORTAÇÃO DOS VALORES ---

Export.table.toDrive({
  collection: finalMeanCollection,
  description: 'Annual_Mean_NDVI_EVI_Mangue_Apicum_MapBiomas', 
  folder: 'GEE_Exports_Means', 
  fileNamePrefix: 'annual_mean_ndvi_evi_mangue_apicum_mapbiomas', 
  fileFormat: 'CSV',
  selectors: ['year', 'mean_NDVI', 'mean_EVI'] 
});

var chartAlt = ui.Chart.feature.groups({
  features: finalMeanCollection,
  xProperty: 'year',
  yProperty: 'mean_NDVI',
  seriesProperty: 'indice'
});

print(chartAlt); // No seu caso você não tem 'indice', então siga com o anterior
 

var chartAlt = ui.Chart.feature.groups({
  features: finalMeanCollection,
  xProperty: 'year',
  yProperty: 'mean_EVI',
  seriesProperty: 'indice'
});

print(chartAlt); // No seu caso você não tem 'indice', então siga com o anterior
 



// --- 7. ESPACIALIZAÇÃO DA JUNÇÃO DO MANGUEZAL E APICUM PARA UM ANO ESPECÍFICO ---

// Defina o ano para a espacialização que deseja visualizar
var yearToVisualize = 2020; // <--- Você pode mudar este ano!

// Selecione a imagem de classificação do MapBiomas para o ano escolhido
var classificationImageToVisualize = mapbiomasAnnualCollection
                                      .filter(ee.Filter.eq('year', yearToVisualize))
                                      .first();

// Crie a máscara para Mangue (ID 5) para o ano de visualização
var mangueMaskVisualize = classificationImageToVisualize.eq(MANGUE_CLASS_ID)
                                                       .selfMask()
                                                       .clip(roi);

// Crie a máscara para Apicum (ID 32) para o ano de visualização
var apicumMaskVisualize = classificationImageToVisualize.eq(APICUM_CLASS_ID)
                                                       .selfMask()
                                                       .clip(roi);

// Combine as máscaras (Mangue OU Apicum) para o ano de visualização
var combinedSpatialMask = mangueMaskVisualize.unmask(0).or(apicumMaskVisualize.unmask(0)).selfMask();

// Defina uma visualização para a máscara combinada
var combinedVis = {
  palette: ['#0000FF'], // Cor azul vibrante para a área combinada
  opacity: 0.7
};

// Adicione a camada da espacialização combinada ao mapa
Map.addLayer(combinedSpatialMask, combinedVis, 'Manguezal + Apicum (' + yearToVisualize + ')');

